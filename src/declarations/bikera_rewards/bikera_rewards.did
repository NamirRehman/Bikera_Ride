type Visibility = 
 variant {
   Private;
   Public;
 };
type UserReward = 
 record {
   amount: TokenAmount;
   claimedAt: opt Timestamp;
   isClaimed: bool;
   reason: RewardReason;
   roundId: opt RoundId;
   timestamp: Timestamp;
   userId: UserId;
 };
type UserId__1 = principal;
type UserId = principal;
type TokenAmount = nat;
type Timestamp__1 = int;
type Timestamp = int;
type StakingInfo = 
 record {
   amount: TokenAmount;
   isActive: bool;
   rewardsEarned: TokenAmount;
   stakedAt: Timestamp;
   unlockTime: Timestamp;
   userId: UserId;
 };
type StakeVisibility = 
 variant {
   Private;
   Public;
 };
type StakeTerms = 
 record {
   durationWeeks: nat;
   endTime: Timestamp__1;
   rewardPercentMicro: nat;
   startTime: Timestamp__1;
   targetDistanceKm: nat;
   targetDistanceM: nat;
 };
type StakeStatus__1 = 
 variant {
   Active;
   Cancelled;
   Failed;
   Settling;
   Succeeded;
 };
type StakeStatus = 
 variant {
   Active;
   Cancelled;
   Failed;
   Settling;
   Succeeded;
 };
type StakeQuote = 
 record {
   durationNs: nat;
   durationWeeks: nat;
   rewardE8s: nat;
   rewardPercentMicro: nat;
   stakeAmountE8s: nat;
   targetDistanceKm: nat;
   targetDistanceM: nat;
   totalPayoutE8s: nat;
 };
type StakeProgress = 
 record {
   allSourcesDistanceM: nat;
   endTime: Timestamp__1;
   isSettleable: bool;
   liveDistanceM: nat;
   memberProgress: vec record {
                         UserId__1;
                         nat;
                       };
   nowTs: Timestamp__1;
   progressBasisPoints: nat;
   requiredProvenance: ProvenanceRequirement__1;
   stakeId: StakeId;
   startTime: Timestamp__1;
   status: StakeStatus__1;
   targetDistanceM: nat;
   timeRemainingNs: nat;
   unverifiedDistanceM: nat;
   verifiedDistanceM: nat;
 };
type StakeMode__1 = 
 variant {
   Group;
   Solo;
 };
type StakeMode = 
 variant {
   Group;
   Solo;
 };
type StakeMember = 
 record {
   contributionStart: Timestamp__1;
   escrowedE8s: nat;
   joinedAt: Timestamp__1;
   payoutE8s: nat;
   rewardE8s: nat;
   stakeAmountE8s: nat;
   status: MemberStatus;
   userId: UserId__1;
   verifiedDistanceM: nat;
 };
type StakeId = nat;
type SettlementOutcome = 
 record {
   membersLocked: nat;
   membersPaid: nat;
   membersSlashed: nat;
   note: text;
   rewardPaidE8s: nat;
   stakeId: MovementStakeId;
   stakeLockedE8s: nat;
   stakeReturnedE8s: nat;
   stakeSlashedE8s: nat;
   status: StakeStatus;
   targetDistanceM: nat;
   targetMet: bool;
   unlockAt: opt Timestamp;
   verifiedDistanceM: nat;
 };
type RoundId = nat;
type RewardsSnapshot = 
 record {
   goalStakingSummary:
    record {
      activePositions: nat;
      pendingRewards: TokenAmount;
      totalStaked: TokenAmount;
    };
   pendingRewards: TokenAmount;
   recentRewards: vec UserReward;
   stakingInfo: vec StakingInfo;
   totalRewards: TokenAmount;
 };
type RewardReason = 
 variant {
   Achievement: text;
   Bonus: text;
   Distance: Distance;
   GoalStaking: nat;
   Mining: RoundId;
   Referral: UserId;
   Staking: TokenAmount;
 };
type RewardMatchRow = 
 record {
   amount: TokenAmount;
   timestamp: Timestamp;
 };
type RewardDistribution = 
 record {
   distributedAt: Timestamp;
   foundationShare: TokenAmount;
   isCompleted: bool;
   roundId: RoundId;
   totalReward: TokenAmount;
   userRewards: vec record {
                      UserId;
                      TokenAmount;
                    };
 };
type RewardConfig = 
 record {
   achievementBonus: TokenAmount;
   distanceRewardRate: nat;
   foundationSharePercentage: nat;
   minStakingAmount: TokenAmount;
   miningRewardPerRound: TokenAmount;
   referralBonus: TokenAmount;
   stakingLockPeriod: nat;
   stakingRewardRate: nat;
 };
type Result_9 = 
 variant {
   err: text;
   ok: TokenAmount;
 };
type Result_8 = 
 variant {
   err: text;
   ok:
    record {
      canisterId: text;
      canisterName: text;
      cycles: nat;
      isPaused: bool;
      memorySize: nat;
      pendingGoalRewards: TokenAmount;
      totalRewards: nat;
      totalStaked: nat;
      uptime: Timestamp;
      version: text;
    };
 };
type Result_7 = 
 variant {
   err: text;
   ok:
    record {
      canStake: bool;
      holdings: TokenAmount;
      holdingsE8s: nat;
      meetsHoldingsRequirement: bool;
      minHoldings: TokenAmount;
      minStakeAmount: TokenAmount;
    };
 };
type Result_6 = 
 variant {
   err: text;
   ok: StakeProgress;
 };
type Result_5 = 
 variant {
   err: text;
   ok: MovementStake;
 };
type Result_4 = 
 variant {
   err: text;
   ok: StakeQuote;
 };
type Result_3 = 
 variant {
   err: text;
   ok: SettlementOutcome;
 };
type Result_2 = 
 variant {
   err: text;
   ok: nat;
 };
type Result_10 = 
 variant {
   err: text;
   ok: GoalStakingSnapshot;
 };
type Result_1 = 
 variant {
   err: text;
   ok: GoalStakePosition;
 };
type Result = 
 variant {
   err: text;
   ok: text;
 };
type ProvenanceRequirement__1 = 
 variant {
   AnyVerified;
   Attested;
   Confirmed;
 };
type ProvenanceRequirement = 
 variant {
   AnyVerified;
   Attested;
   Confirmed;
 };
type MovementStakingSummary = 
 record {
   activeStakedE8s: nat;
   activeStakes: vec MovementStake;
   config: MovementStakingConfig;
   failureCount: nat;
   lifetimeRewardE8s: nat;
   lifetimeSlashedE8s: nat;
   projectedRewardE8s: nat;
   settledStakes: vec MovementStake;
   successCount: nat;
 };
type MovementStakingMetrics = 
 record {
   activeStakes: nat;
   automatedSettlementActive: bool;
   dueForSettlement: nat;
   failedStakes: nat;
   groupStakes: nat;
   lifetimeRewardsPaidE8s: nat;
   lifetimeSlashedE8s: nat;
   lifetimeStakeReturnedE8s: nat;
   soloStakes: nat;
   succeededStakes: nat;
   totalEscrowedE8s: nat;
   totalStakes: nat;
 };
type MovementStakingConfig = 
 record {
   autoSettleIntervalSeconds: nat;
   maxGroupMembers: nat;
   maxSettlementsPerBatch: nat;
   paused: bool;
 };
type MovementStakeId = nat;
type MovementStake = 
 record {
   createdAt: Timestamp__1;
   creator: UserId__1;
   id: StakeId;
   inviteCode: opt text;
   joinDeadline: Timestamp__1;
   maxMembers: nat;
   members: vec StakeMember;
   mode: StakeMode__1;
   settledAt: opt Timestamp__1;
   settlementNote: text;
   status: StakeStatus__1;
   terms: StakeTerms;
   title: text;
   totalStakedE8s: nat;
   verifiedDistanceM: nat;
   visibility: Visibility;
 };
type MovementAttestationPolicy = 
 record {
   group: ProvenanceRequirement;
   solo: ProvenanceRequirement;
 };
type MemberStatus = 
 variant {
   Active;
   Locked;
   Paid;
   Refunded;
   Released;
   Releasing;
   Slashed;
   StakeReturned;
 };
type JoinGroupStakeRequest = 
 record {
   inviteCode: opt text;
   stakeAmountE8s: nat;
   stakeId: MovementStakeId;
 };
type GoalStakingSnapshotStatus = 
 variant {
   Distributed;
   PendingDistribution;
 };
type GoalStakingSnapshot = 
 record {
   allocations: vec record {
                      UserId;
                      TokenAmount;
                    };
   createdAt: Timestamp;
   id: nat;
   periodEnd: Timestamp;
   periodStart: Timestamp;
   rewardAmount: TokenAmount;
   status: GoalStakingSnapshotStatus;
   totalEligibleStake: TokenAmount;
 };
type GoalStakingConfig = 
 record {
   lockPeriod: nat;
   minHoldings: TokenAmount;
   minStakeAmount: TokenAmount;
   roundRewardShare: nat;
 };
type GoalStakeStatus = 
 variant {
   Active;
   Closed;
   PendingUnstake;
 };
type GoalStakePosition = 
 record {
   accumulatedRewards: TokenAmount;
   amount: TokenAmount;
   amountE8s: nat;
   id: GoalStakeId;
   lastSnapshotId: opt nat;
   stakedAt: Timestamp;
   status: GoalStakeStatus;
   unlockAt: Timestamp;
   userId: UserId;
 };
type GoalStakeId = nat;
type Distance = nat;
type CreateSoloStakeRequest = 
 record {
   durationWeeks: nat;
   stakeAmountE8s: nat;
   targetDistanceKm: nat;
   title: text;
 };
type CreateGroupStakeRequest = 
 record {
   durationWeeks: nat;
   inviteCode: opt text;
   invitedUsernames: vec text;
   joinWindowHours: opt nat;
   maxMembers: nat;
   stakeAmountE8s: nat;
   targetDistanceKm: nat;
   title: text;
   visibility: StakeVisibility;
 };
type ClaimRequest = 
 record {
   amount: TokenAmount;
   processedAt: opt Timestamp;
   reason: RewardReason;
   status: text;
   timestamp: Timestamp;
   userId: UserId;
 };
type CanisterId = principal;
service : {
  addAdminPrincipal: (principal) -> (Result);
  /// Emergency refund. The only route that returns money before the end of a period, and it
  /// pays back the stake without any reward. For incidents, not for changing one's mind.
  adminCancelMovementStake: (MovementStakeId, text) -> (Result_5);
  calculateGoalStakingRewards: (Timestamp, Timestamp) -> (Result_10);
  /// The rider may recover a missed-goal stake after its distance-based calendar-month lock.
  /// A persisted #Releasing state prevents double payment if the canister stops after the
  /// ledger transfer. An administrator must reconcile that rare state against the ledger.
  claimLockedMovementStake: (MovementStakeId) -> (Result_2);
  /// Claim a specific reward by index
  /// NOTE: Tokens are already minted to user's account during distributeMiningRewards
  /// This function just marks the reward as claimed for UI purposes
  claimReward: (nat, UserId) -> (Result);
  /// Clear old data (admin only)
  clearOldData: () -> (Result);
  /// Create a group stake. The creator is its first member; others join with their own stake.
  createGroupStake: (CreateGroupStakeRequest) -> (Result_5);
  /// Create a solo stake. The caller escrows their stake and rides alone.
  createSoloStake: (CreateSoloStakeRequest) -> (Result_5);
  distributeAchievementReward: (UserId, text) -> (Result);
  distributeDistanceReward: (UserId, Distance) -> (Result_9);
  distributeGoalStakingRewards: (nat) -> (Result);
  /// Distribute mining rewards to winners
  distributeMiningRewards: (RoundId, vec UserId, TokenAmount) -> (Result);
  distributeReferralReward: (UserId, UserId) -> (Result);
  /// Emergency pause (admin only)
  emergencyPause: () -> (Result);
  /// Resume system operations (admin only)
  emergencyResume: () -> (Result);
  /// Release a stake stuck in #Settling after an interrupted run, so it can be retried.
  forceResetMovementSettlement: (MovementStakeId) -> (Result);
  getActiveStaking: (UserId, opt nat) -> (vec StakingInfo) query;
  /// Get all rewards for all users (admin only) - for debugging
  getAllRewards: () -> (vec record {
                              UserId;
                              vec UserReward;
                            }) query;
  /// Return a capped subset of rewards (admin-only use-case).
  /// This avoids instruction-limit failures and huge responses when the dataset grows.
  /// 
  /// - `usersLimit`: max number of users to return (default 200, max 1000)
  /// - `rewardsPerUserLimit`: max rewards per user (most recent) (default 50, max 200)
  getAllRewardsCapped: (opt nat, opt nat) ->
   (vec record {
          UserId;
          vec UserReward;
        }) query;
  /// Get canister status including cycle balance (admin only)
  getCanisterStatus: () -> (Result_8);
  getClaimRequest: (text) -> (opt ClaimRequest) query;
  getGoalSnapshot: (nat) -> (opt GoalStakingSnapshot) query;
  getGoalStakePositions: (UserId, opt nat) -> (vec GoalStakePosition) query;
  getGoalStakingConfig: () -> (GoalStakingConfig) query;
  getGoalStakingEligibility: (UserId) -> (Result_7);
  getGoalStakingMetrics: () ->
   (record {
      automatedSystemActive: bool;
      pendingSnapshots: nat;
      totalActiveStakeAmount: TokenAmount;
      totalActiveStakes: nat;
      totalDistributedRewards: TokenAmount;
      totalPendingRewards: TokenAmount;
      totalSnapshots: nat;
    }) query;
  getGoalStakingSummary: (UserId) ->
   (record {
      accumulatedRewards: TokenAmount;
      config: GoalStakingConfig;
      pendingDistributionPool: TokenAmount;
      positions: vec GoalStakePosition;
      totalActiveStake: TokenAmount;
    }) query;
  /// The requirement NEW stakes get, per mode. Shown before a rider stakes.
  getMovementAttestationPolicy: () -> (MovementAttestationPolicy) query;
  /// Reward percentage alone, in micro-percent (1_000_000 == 1%). Handy for rendering a
  /// curve without quoting an amount.
  getMovementRewardPercentMicro: (nat, nat) -> (nat) query;
  getMovementRewardPercentMicroForMode: (StakeMode, nat, nat) -> (nat) query;
  getMovementSlashPoolBalance: () -> (Result_2);
  getMovementStake: (MovementStakeId) -> (opt MovementStake) query;
  /// The invite code of a private group, for its creator only - so they can share it again.
  /// Every other caller gets the same error whether or not the group exists, so this cannot
  /// be used to probe for private groups.
  getMovementStakeInviteCode: (MovementStakeId) -> (Result) query;
  /// Verified distance so far against the target. This reaches into bikera_user, so it is an
  /// update call rather than a query.
  getMovementStakeProgress: (MovementStakeId) -> (Result_6);
  /// The requirement a specific stake was created under.
  getMovementStakeRequirement: (MovementStakeId) ->
   (ProvenanceRequirement) query;
  getMovementStakesDueForSettlement: (opt nat) -> (vec MovementStakeId) query;
  getMovementStakingBounds: () ->
   (record {
      e8sPerToken: nat;
      groupMaxDistanceKm: nat;
      groupMinDistanceKm: nat;
      maxDistanceKm: nat;
      maxDurationWeeks: nat;
      minDistanceKm: nat;
      minDurationWeeks: nat;
      percentScale: nat;
      soloMaxDistanceKm: nat;
      soloMinDistanceKm: nat;
    }) query;
  getMovementStakingConfig: () -> (MovementStakingConfig) query;
  getMovementStakingMetrics: () -> (MovementStakingMetrics) query;
  getMovementStakingSummary: (UserId) -> (MovementStakingSummary) query;
  getPendingClaimRequests: () -> (vec record {
                                        text;
                                        ClaimRequest;
                                      }) query;
  /// Get pending snapshots that need distribution (admin only)
  getPendingGoalSnapshots: () -> (vec GoalStakingSnapshot) query;
  getRewardConfig: () -> (RewardConfig) query;
  getRewardDistribution: (RoundId) -> (opt RewardDistribution) query;
  getRewardMatchRows: (UserId, opt nat) -> (vec RewardMatchRow) query;
  /// Get all rewards for a specific round (admin only)
  getRewardsByRound: (RoundId) -> (vec record {
                                         UserId;
                                         UserReward;
                                       }) query;
  /// Get complete rewards data in single query
  /// Replaces: getUserRewards(), getUnclaimedRewards(), getStakingInfo(), getGoalStakingSummary()
  /// Result: 1 call instead of 4+ calls (4X reduction)
  getRewardsSnapshot: (UserId) -> (RewardsSnapshot) query;
  /// Get summary of all rewards (total count, total amount, by user, etc.) - admin only
  getRewardsSummary: () ->
   (record {
      rewardsByUser: vec record {
                           UserId;
                           nat;
                           TokenAmount;
                         };
      totalAmount: TokenAmount;
      totalRewards: nat;
      totalUsers: nat;
      unclaimedAmount: TokenAmount;
    }) query;
  getStakingInfo: (UserId, opt nat) -> (vec StakingInfo) query;
  getTotalDistributed: () -> (TokenAmount) query;
  getTotalStaked: () -> (TokenAmount) query;
  getTotalUnclaimedRewards: (UserId) -> (TokenAmount) query;
  getUnclaimedRewards: (UserId, opt nat) -> (vec UserReward) query;
  getUserMovementStakes: (UserId, opt nat, opt nat) ->
   (vec MovementStake) query;
  getUserRewards: (UserId, opt nat) -> (vec UserReward) query;
  /// EFFICIENT: Get user rewards snapshot (single call instead of multiple)
  /// Combines user rewards, staking info, and stats in one efficient query
  getUserRewardsSnapshot: (UserId) ->
   (record {
      activeStakes: nat;
      canClaim: bool;
      lastReward: opt UserReward;
      nextClaimTime: opt Timestamp;
      pendingRewards: TokenAmount;
      rewardHistory: vec UserReward;
      stakedAmount: TokenAmount;
      totalRewards: TokenAmount;
    });
  /// Check if automated GoalStaking reward system is active
  isAutomatedGoalStakingActive: () -> (bool) query;
  isAutomatedMovementSettlementActive: () -> (bool) query;
  /// Check if system is paused
  isSystemPaused: () -> (bool) query;
  /// Join an existing group stake. The group's terms - duration, target and reward
  /// percentage - are already fixed; only the joiner's own stake amount is chosen here.
  joinGroupStake: (JoinGroupStakeRequest) -> (Result_5);
  listGoalSnapshots: (opt nat) -> (vec GoalStakingSnapshot) query;
  /// Public group stakes that are still inside their join window and have room.
  listOpenGroupStakes: (opt nat, opt nat) -> (vec MovementStake) query;
  /// The authoritative reward quote. The frontend mirrors this formula for live slider
  /// feedback, but this is the number that gets written into a stake.
  previewMovementStake: (nat, nat, nat) -> (Result_4) query;
  /// Mode-aware quote used by current clients. The legacy three-argument query above remains
  /// available and prices a solo challenge for backwards compatibility.
  previewMovementStakeForMode: (StakeMode, nat, nat, nat) -> (Result_4) query;
  processClaimRequest: (text, bool) -> (Result);
  /// Resolve an interrupted #Releasing claim only after checking the ledger transaction.
  reconcileMovementRelease: (MovementStakeId, principal, bool) -> (Result);
  removeAdminPrincipal: (principal) -> (Result);
  /// Set canister references (admin only)
  /// NOTE: Canisters are pre-initialized with production IDs, but this function
  /// allows updating them if needed (e.g., for testing or migration)
  setCanisterReferences: (CanisterId, CanisterId, CanisterId) -> (Result);
  /// Change the requirement for stakes created from now on. Existing stakes are unaffected.
  setMovementAttestationPolicy: (MovementAttestationPolicy) -> (Result);
  setMovementStakingPaused: (bool) -> (Result);
  setUserCanisterReference: (CanisterId) -> (Result);
  /// Settle every stake that is due, up to `maxSettlementsPerBatch`.
  settleDueMovementStakes: () -> (Result);
  /// Settle a stake whose period has ended. Permissionless on purpose: a user must never
  /// have to wait for an operator to get their stake back. Safe to call repeatedly.
  settleMovementStake: (MovementStakeId) -> (Result_3);
  stakeGoalTokens: (TokenAmount) -> (Result_1);
  /// Legacy staking API retained for backwards compatibility
  stakeTokens: (TokenAmount, UserId) -> (Result);
  /// Start automated GoalStaking reward calculation and distribution
  /// Runs daily to calculate and distribute rewards from pending pool
  startAutomatedGoalStakingRewards: () -> (Result);
  startAutomatedMovementSettlement: () -> (Result);
  /// Stop automated GoalStaking reward system
  stopAutomatedGoalStakingRewards: () -> (Result);
  stopAutomatedMovementSettlement: () -> (Result);
  /// Legacy slash-pool sweep. All open and missed-goal-locked stakes remain reserved.
  sweepMovementSlashPool: (principal, nat) -> (Result_2);
  /// Test function to manually add a reward (for debugging) - ADMIN ONLY
  /// DISABLED IN PRODUCTION: This function is restricted to admin only to prevent test rewards
  testAddReward: (UserId, TokenAmount, opt RoundId) -> (Result);
  unstakeGoalTokens: (GoalStakeId) -> (Result_1);
  unstakeTokens: (nat, UserId) -> (Result);
  updateGoalStakingConfig: (GoalStakingConfig) -> (Result);
  updateMovementStakingConfig: (MovementStakingConfig) -> (Result);
  /// Update reward configuration (admin only)
  updateRewardConfig: (RewardConfig) -> (Result);
}
