type UserId = principal;
type TokenAmount = nat;
type Timestamp = int;
type SystemStats = 
 record {
   activeUsers: nat;
   systemUptime: Timestamp;
   totalIMERAClaimed: TokenAmount;
   totalIMERAMined: TokenAmount;
   totalRounds: nat;
   totalUsers: nat;
   totalXP: nat;
 };
type SystemConfig = 
 record {
   claimCooldown: nat;
   foundationShare: nat;
   globalSolanaCap: TokenAmount;
   maxClaimPercentage: nat;
   maxDailyWins: nat;
   maxSpeed: Speed;
   maxWinnersPerRound: nat;
   minDistancePerRound: Distance;
   miningInterval: nat;
   premineAmount: TokenAmount;
   tokensPerRound: TokenAmount;
 };
type Speed = nat;
type RoundState = 
 variant {
   Calculating;
   Committed;
   Finalized;
   Open;
 };
type RoundId = nat;
type Result_9 = 
 variant {
   err: text;
   ok:
    record {
      canisterId: text;
      canisterName: text;
      computeAllocation: nat;
      currentRoundId: RoundId;
      cycles: nat;
      freezingThreshold: nat;
      isPaused: bool;
      memoryAllocation: nat;
      memorySize: nat;
      reservedCyclesLimit: nat;
      systemConfig: SystemConfig;
      totalRounds: nat;
      uptime: Timestamp;
      version: text;
    };
 };
type Result_8 = 
 variant {
   err: text;
   ok:
    record {
      closed: nat;
      inProgress: nat;
      pending: nat;
      resolved: nat;
      total: nat;
    };
 };
type Result_7 = 
 variant {
   err: text;
   ok: ContactSubmission;
 };
type Result_6 = 
 variant {
   err: text;
   ok:
    record {
      canisterId: text;
      canisterName: text;
      cycles: nat;
      isPaused: bool;
      memorySize: nat;
      uptime: Timestamp;
      version: text;
    };
 };
type Result_5 = 
 variant {
   err: text;
   ok:
    record {
      isStuck: bool;
      monitoring:
       opt
        record {
          duration: Timestamp;
          failedSubmissions: nat;
          retryCount: nat;
        };
      round: opt MiningRound;
      timeSinceSubmission: opt Timestamp;
    };
 };
type Result_4 = 
 variant {
   err: text;
   ok: vec MiningRound;
 };
type Result_3 = 
 variant {
   err: text;
   ok: record {
         complete: bool;
         cursor: nat;
         processed: nat;
         sourceSize: nat;
       };
 };
type Result_2 = 
 variant {
   err: text;
   ok: ContactId;
 };
type Result_11 = 
 variant {
   err: text;
   ok: vec UserId;
 };
type Result_10 = 
 variant {
   err: text;
   ok: vec principal;
 };
type Result_1 = 
 variant {
   err: text;
   ok: text;
 };
type Result = 
 variant {
   err: text;
   ok: nat;
 };
type MiningRoundSnapshot = 
 record {
   currentRound: opt MiningRound;
   roundHistory: vec MiningRound;
   topWinners: vec UserId;
   userRank: opt nat;
   userTotalDistance: Distance;
   userWins: nat;
 };
type MiningRound = 
 record {
   activeUsers: vec UserId;
   committedAt: opt Timestamp;
   endTime: Timestamp;
   finalizedAt: opt Timestamp;
   id: RoundId;
   isCompleted: bool;
   lastError: opt text;
   retryCount: nat;
   startTime: Timestamp;
   state: RoundState;
   submittedAt: opt Timestamp;
   timeoutAt: opt Timestamp;
   totalMined: TokenAmount;
   winners: vec UserId;
 };
type Distance = nat;
type ContactSubmission = 
 record {
   adminNotes: opt text;
   email: text;
   id: ContactId;
   message: text;
   name: text;
   respondedAt: opt Timestamp;
   status: ContactStatus;
   subject: text;
   timestamp: Timestamp;
   userId: opt UserId;
 };
type ContactStatus = 
 variant {
   Closed;
   InProgress;
   Pending;
   Resolved;
 };
type ContactId = text;
type CanisterId = principal;
service : {
  /// Add an administrator. Password rotation and allowlist management remain
  /// exclusive to the immutable super-admin.
  addAdminPrincipal: (principal) -> (Result_1);
  /// Manual completion is an admin operation. Automatic completion uses the
  /// private scheduler path, preventing stale or malicious clients from
  /// generating paid update traffic.
  completeMiningRound: (RoundId) -> (Result_11);
  /// Delete contact submission (admin only)
  deleteContactSubmission: (ContactId) -> (Result_1);
  /// Force recover a stuck round (admin only)
  forceRecoverRound: (RoundId) -> (Result_1);
  /// Return the password version so the frontend can reject sessions created
  /// before the most recent password rotation.
  getAdminPasswordVersion: () -> (Result) query;
  /// List authorized dashboard administrators. Admins may view the list, but
  /// only the super-admin can modify it.
  getAdminPrincipals: () -> (Result_10) query;
  /// Get all contact submissions (admin only)
  getAllContactSubmissions: (opt nat, opt ContactStatus) ->
   (vec ContactSubmission) query;
  /// Cheap dashboard path: no consensus and no inter-canister update call.
  getCachedSystemStats: () -> (SystemStats) query;
  getCallerText: () -> (text);
  getCanisterIds: () ->
   (record {
      consensus: opt CanisterId;
      imera: opt CanisterId;
      rewards: opt CanisterId;
      user: opt CanisterId;
      validator: opt CanisterId;
      xp: opt CanisterId;
    });
  /// Get canister status including cycle balance (admin only)
  getCanisterStatus: () -> (Result_9);
  /// Get contact statistics (admin only)
  getContactStats: () -> (Result_8) query;
  /// Get contact submission by ID (user can only see their own, admin can see all)
  getContactSubmission: (ContactId) -> (Result_7) query;
  getCurrentRound: () -> (opt MiningRound) query;
  /// Get frontend canister status (bikera_main is a controller, so it can query it)
  getFrontendCanisterStatus: () -> (Result_6);
  /// Get complete mining round data in single query
  /// Replaces: getCurrentRound(), getUserWins(), getTopWinners()
  /// Result: 1 call instead of 3+ calls (3X reduction)
  getMiningRoundSnapshot: (UserId) -> (MiningRoundSnapshot) query;
  /// Get all contact submissions for current user
  getMyContactSubmissions: () -> (vec ContactSubmission) query;
  getRound: (RoundId) -> (opt MiningRound) query;
  getRoundArchiveStatus: () ->
   (record {
      archiveDataBytes: nat64;
      archiveDataPages: nat64;
      cycleBalance: nat;
      hotRoundCount: nat;
      indexedUsers: nat;
      migrationComplete: bool;
      migrationCursor: nat;
      migrationSourceSize: nat;
    }) query;
  /// Get round monitoring data (admin only)
  getRoundMonitoring: (RoundId) -> (Result_5) query;
  /// Get all stuck rounds (admin only)
  getStuckRounds: () -> (Result_4) query;
  /// Expose the immutable owner so the dashboard can hide owner-only controls
  /// from regular administrators.
  getSuperAdminPrincipal: () -> (principal) query;
  getSystemConfig: () -> (SystemConfig) query;
  /// Get current system statistics
  /// NOTE: Active user count is cached to reduce inter-canister load
  getSystemStats: () -> (SystemStats);
  /// Initialize all canister references for inter-canister communication
  /// NOTE: Canisters are pre-initialized with production IDs, but this function
  /// allows updating them if needed (e.g., for testing or migration)
  /// If null is passed for any canister, uses production ID as default
  initializeCanisters: (opt CanisterId, opt CanisterId, opt CanisterId,
   opt CanisterId, opt CanisterId, opt CanisterId) -> (Result_1);
  /// Check if automated mining is active
  isAutomatedMiningActive: () -> (bool) query;
  /// Run an explicit bounded migration batch. This lets operations finish the
  /// one-time archive migration before the next deployment without a single
  /// unbounded instruction-heavy update.
  migrateRoundArchive: (nat) -> (Result_3);
  /// Remove a regular administrator. The immutable super-admin cannot be
  /// removed, preventing the dashboard from being orphaned.
  removeAdminPrincipal: (principal) -> (Result_1);
  /// Reset entire system (admin only)
  resetSystem: () -> (Result_1);
  /// Rotate the super-admin password. Passwords arrive as PBKDF2-derived digests and
  /// only the digest is persisted. The version advances so older sessions are stale.
  rotateAdminPassword: (text, text) -> (Result);
  /// Start automated 5-minute mining rounds
  startAutomatedMining: () -> (Result_1);
  /// Stop automated mining rounds
  stopAutomatedMining: () -> (Result_1);
  /// Submit a contact form (anyone can submit)
  submitContactForm: (text, text, text, text) -> (Result_2);
  /// Update contact submission status (admin only)
  updateContactStatus: (ContactId, ContactStatus, opt text) -> (Result_1);
  /// Update system configuration (admin only)
  updateSystemConfig: (SystemConfig) -> (Result_1);
  /// Verify the admin password digest and return its current rotation version.
  /// The Internet Identity principal remains the primary authorization boundary.
  verifyAdminPassword: (text) -> (Result);
}
